# 只在开发模式中被载入
VITE_PORT = 9811

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否开启 mock
VITE_USE_MOCK = false

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = true

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
#VITE_PROXY = [["/appApi","http://localhost:9811"],["/upload","http://localhost:9811/upload"]]
#VITE_PROXY=[["/api","https://naive-ui-admin"]]

# API 接口地址（本地 xservice 后端）
VITE_GLOB_API_URL = http://localhost:8080

# 接口前缀（新后端为空）
VITE_GLOB_API_URL_PREFIX =

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址（MinIO 地址，用于云盘预览等）
VITE_GLOB_FILE_URL = http://127.0.0.1:9000
