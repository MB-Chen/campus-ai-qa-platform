# 只在生产模式（构建）时载入
# 说明：本文件所有 VITE_GLOB_* 变量在打包时会被写进 dist 下的 _app.config.js，
#       运行时挂到 window.__PRODUCTION__{shortName}__CONF__ 并被 Object.freeze。
#       因此部署后 API 地址以本文件为准——请按实际后端地址修改，改完需重新构建。

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否开启 mock
VITE_USE_MOCK = false

# 是否删除console
VITE_DROP_CONSOLE = true

# API 接口地址（生产后端地址，docker 部署时后端端口为 8989）
# 部署时请改成你的真实后端地址，例如 http://your-domain:8989
VITE_GLOB_API_URL = http://localhost:8989

# 接口前缀（后端 context-path 为 /，无统一前缀，必须留空）
VITE_GLOB_API_URL_PREFIX =

# 文件上传地址（留空走默认，与 API 同址）
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址（MinIO 地址，用于云盘预览等，与 dev 保持一致）
VITE_GLOB_FILE_URL = http://127.0.0.1:9000

# 是否启用gzip压缩或brotli压缩
# 可选: gzip | brotli | none
# 如果你需要多种形式，你可以用','来分隔
VITE_BUILD_COMPRESS = 'none'

# 使用压缩时是否删除原始文件，默认为false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false
